
FROM golang:1.24-alpine

# Install air for hot reload

RUN apk add --no-cache git curl
RUN go install github.com/air-verse/air@latest

WORKDIR /app

# Copy go mod/sum

COPY  go.mod go.sum ./
RUN go mod download

# Copy rest

COPY . .

EXPOSE 8090

# Use air for hot reload

CMD ["air", "-c", ".air.toml"]
